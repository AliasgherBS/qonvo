# Qonvo environment configuration.
# Copy to `.env` and fill in real values: `cp .env.example .env`
# The backend reads QONVO_-prefixed vars via pydantic-settings; the remaining
# vars configure the Postgres/MinIO/WAHA containers in docker-compose.yml.

# --------------------------------------------------------------------------- #
# General
# --------------------------------------------------------------------------- #
# Base domain; Caddy serves app.<DOMAIN> (dashboard) and api.<DOMAIN> (api).
DOMAIN=localhost
QONVO_ENVIRONMENT=production
QONVO_DEBUG=false
QONVO_LOG_LEVEL=INFO
QONVO_DOMAIN=qonvo.example.com

# --------------------------------------------------------------------------- #
# Postgres (container + app DSN)
# --------------------------------------------------------------------------- #
POSTGRES_USER=qonvo
POSTGRES_PASSWORD=dev-postgres-pass
POSTGRES_DB=qonvo
# Async SQLAlchemy DSN — host is the compose service name `postgres`.
QONVO_DATABASE_URL=postgresql+asyncpg://qonvo_app:dev-app-pass@postgres:5432/qonvo
QONVO_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://qonvo:dev-postgres-pass@postgres:5432/qonvo
APP_DB_PASSWORD=dev-app-pass
QONVO_SYSTEM_DATABASE_URL=postgresql+asyncpg://qonvo_system:dev-system-pass@postgres:5432/qonvo
SYSTEM_DB_PASSWORD=dev-system-pass

# --------------------------------------------------------------------------- #
# Redis (queue, dedupe, debounce, locks, rate limiting)
# --------------------------------------------------------------------------- #
QONVO_REDIS_URL=redis://redis:6379/0

# --------------------------------------------------------------------------- #
# WAHA (WhatsApp HTTP API)
# --------------------------------------------------------------------------- #
# Shared API key: WAHA container auth AND backend outbound calls.
WAHA_API_KEY=dev-waha-key-change-me
QONVO_WAHA_API_KEY=dev-waha-key-change-me
# Backend → WAHA base URL (compose service name).
QONVO_WAHA_BASE_URL=http://waha:3000
# Fallback HMAC secret for verifying inbound webhooks (X-Webhook-Hmac).
# Per-session secrets are generated on session create and take precedence.
QONVO_WAHA_HMAC_SECRET=change-me-waha-hmac-secret
QONVO_WAHA_DEFAULT_ENGINE=WEBJS
# URL WAHA posts webhooks to (reachable from the waha container).
QONVO_WEBHOOK_URL=http://api:8000/webhooks/waha
QONVO_WEBHOOK_RETRIES=3

# --------------------------------------------------------------------------- #
# Security
# --------------------------------------------------------------------------- #
# JWT secret shared with the dashboard (Auth.js mints, FastAPI verifies). >=32 bytes.
QONVO_JWT_SECRET=change-me-generate-with-secrets-token_urlsafe-48
QONVO_JWT_ALGORITHM=HS256
# Fernet master key for encrypting per-tenant integration credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store OUTSIDE the repo and back up separately (DESIGN.md §3, §12.2).
QONVO_FERNET_KEY=G0r0veGNMhnBDh5Ft9m1B0PtNBLTgnGnuNU1KVxRz9M=

# --------------------------------------------------------------------------- #
# MinIO (media object storage — required, DESIGN.md §12.3)
# --------------------------------------------------------------------------- #
MINIO_ROOT_USER=qonvo-minio
MINIO_ROOT_PASSWORD=dev-minio-pass
QONVO_MINIO_ENDPOINT=minio:9000
QONVO_MINIO_ACCESS_KEY=qonvo
QONVO_MINIO_SECRET_KEY=change-me-minio-password
QONVO_MINIO_BUCKET=qonvo-media
QONVO_MINIO_SECURE=false

# --------------------------------------------------------------------------- #
# Pipeline tuning (optional — sensible defaults in app/core/config.py)
# --------------------------------------------------------------------------- #
# QONVO_DEBOUNCE_WINDOW_SECONDS=5.0
# QONVO_STALENESS_THRESHOLD_SECONDS=7200
# QONVO_SEND_MIN_DELAY_SECONDS=3.0
# QONVO_SEND_MAX_DELAY_SECONDS=8.0
# QONVO_SEND_DEFAULT_DAILY_CAP=500

# --------------------------------------------------------------------------- #
# Backups (scripts/backup.sh)
# --------------------------------------------------------------------------- #
# BACKUP_TARGET_DIR=/var/backups/qonvo
# BACKUP_RETENTION_DAYS=14
# BACKUP_MINIO_TARGET=              # e.g. s3/backup-bucket (an mc alias/path)
QONVO_LLM_PROVIDER=gemini
QONVO_LLM_MODEL=gemini-2.5-flash
QONVO_LLM_API_KEY=AIzaSyA3o-UtiKZL4ybSMVueLEwiSMP0EbdiDeQ
QONVO_EMBEDDING_PROVIDER=gemini
QONVO_EMBEDDING_MODEL=gemini-embedding-001
QONVO_EMBEDDING_API_KEY=AIzaSyA3o-UtiKZL4ybSMVueLEwiSMP0EbdiDeQ
# Demo-snappy pacing (production defaults are more conservative)
QONVO_DEBOUNCE_WINDOW_SECONDS=3
QONVO_TYPING_MAX_SECONDS=4
QONVO_SEND_MIN_DELAY_SECONDS=1
QONVO_SEND_MAX_DELAY_SECONDS=3
QONVO_CORS_ORIGINS=["http://localhost:3002","http://127.0.0.1:3002","http://0.0.0.0:3002"]
