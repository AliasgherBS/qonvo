# What is NOT committed: secrets, dependencies, build output, caches, and local
# tool state. The .env.example templates ARE tracked as a pick-up-and-go guide;
# copy them to .env / .env.local and fill in real values locally.

# Secrets — never commit. Provider secret-scanning (Google, Groq, …) auto-revokes
# API keys the moment they land in a repo, even a private one, so real keys must
# stay untracked. Templates (.env.example) are kept.
.env
.env.*
!.env.example
!.env.staging.example
!*.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Local tooling / agent + editor state
.omc/
.claude/
.playwright-mcp/
.vercel/
.DS_Store

# Logs & local data volumes
*.log
.data/

# Monitoring: Gmail app password for Alertmanager email (never commit)
monitoring/alertmanager/smtp_password

# Windows "downloaded from the internet" markers, created by WSL/Explorer.
*:Zone.Identifier

# --------------------------------------------------------------------------- #
# Large binaries and generated marketing output.
# Git keeps every version of a binary forever and cannot diff them. The brand
# kit and promo video are 15 MB of the repo's 26 MB history; the dashboard
# already carries its own optimised copies (public/hero.mp4, public/logo-*).
# The logo PNGs stay tracked: 112 KB, and pitch-decks/src/hub.mjs reads them.
# --------------------------------------------------------------------------- #
Branding+Marketing/*.pdf
Branding+Marketing/*.mp4
Branding+Marketing/pitch-decks/
Branding+Marketing/promo-video/
Branding+Marketing/qonvo-marketing-kit.*

# Local test data for the end-to-end run (see docs/E2E-LIVE-TEST-PLAN.md).
fixtures/

# Superseded by dashboard/lib/legal.ts, which the Terms and Privacy pages
# render from and which calls itself the single source of truth. Keeping a
# second copy in markdown only invites the two to drift apart.
legal/
