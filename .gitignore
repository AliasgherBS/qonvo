# What is NOT committed: dependencies, build output, caches, and local tool state.
# Everything else — INCLUDING .env with real values and brand assets — is
# intentionally tracked so a new device is pick-up-and-go (private, single-owner
# repo). Rotate the secrets in .env if this repo ever stops being private/solo.

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Local tooling / agent + editor state
.omc/
.claude/
.playwright-mcp/
.vercel/
.DS_Store

# Logs & local data volumes
*.log
.data/
