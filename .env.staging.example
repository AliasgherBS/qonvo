# --------------------------------------------------------------------------- #
# Qonvo — STAGING environment
# --------------------------------------------------------------------------- #
# A second, fully isolated stack on the same box: its own database, Redis, WAHA
# sessions and object storage, on its own host ports. Brought up by
# ./qonvo-staging.sh, which runs compose under the project name `qonvo-staging`
# so Docker namespaces every volume and network away from production.
#
# Copy to .env.staging and change every secret. Start from your production .env
# so the AI provider keys carry over, then override everything below.
#
#   cp .env .env.staging && cat .env.staging.example >> .env.staging
#
# What must differ from production, and why:
#   * host ports        — or the two stacks fight over the same sockets
#   * database password — staging is where risky things get tried
#   * WAHA api key      — a staging session must never reach a real customer
#   * the tunnel URL    — see the note on OAuth at the bottom
# --------------------------------------------------------------------------- #

# --- Host ports (production uses 5433 / 6380 / 8000 / 3001 / 9000 / 9001) ---- #
POSTGRES_HOST_PORT=5443
REDIS_HOST_PORT=6390
API_HOST_PORT=8010
WAHA_HOST_PORT=3011
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
# Caddy is not used in staging; these only exist so the container cannot bind 80.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# --- Datastores -------------------------------------------------------------- #
# Same service names (the compose network is per-project, so `postgres` inside
# the staging network is the staging database).
POSTGRES_PASSWORD=change-me-staging-postgres
APP_DB_PASSWORD=change-me-staging-app
SYSTEM_DB_PASSWORD=change-me-staging-system
QONVO_DATABASE_URL=postgresql+asyncpg://qonvo_app:change-me-staging-app@postgres:5432/qonvo
QONVO_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://qonvo:change-me-staging-postgres@postgres:5432/qonvo
QONVO_SYSTEM_DATABASE_URL=postgresql+asyncpg://qonvo_system:change-me-staging-system@postgres:5432/qonvo

# --- WhatsApp ---------------------------------------------------------------- #
# A DIFFERENT key from production. Sessions are per-stack; link a spare number
# here, never the number your customers message.
WAHA_API_KEY=change-me-staging-waha
QONVO_WAHA_API_KEY=change-me-staging-waha
QONVO_WAHA_HMAC_SECRET=change-me-staging-hmac

# --- Identity ---------------------------------------------------------------- #
# A different JWT secret means a production token cannot be replayed against
# staging, and vice versa.
QONVO_JWT_SECRET=change-me-staging-jwt-secret-at-least-32-bytes
# A different Fernet key means staging cannot decrypt production's stored
# Google refresh tokens even if a dump is restored into it by mistake.
QONVO_FERNET_KEY=change-me-generate-with-fernet-generate-key

# --- Email ------------------------------------------------------------------- #
# Staging must never send a real customer an email. `log` writes them to the
# container log instead of delivering them.
QONVO_EMAIL_PROVIDER=log

# --- Billing ----------------------------------------------------------------- #
# Keep staging on the manual adapter unless you are specifically testing a
# gateway, and then only against that gateway's sandbox.
QONVO_BILLING_PROVIDER=manual

# --- Tunnel / OAuth ---------------------------------------------------------- #
# Google redirect URIs are registered per exact URL, so testing Sign in with
# Google or Calendar/Sheets against staging needs a SECOND ngrok domain added to
# the Cloud console alongside production's. Until you do that, staging supports
# email+password login and everything that does not touch Google.
QONVO_DASHBOARD_BASE_URL=http://localhost:3012
QONVO_GOOGLE_OAUTH_REDIRECT_BASE=http://localhost:8010
