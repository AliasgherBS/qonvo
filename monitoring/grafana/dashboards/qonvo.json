          "expr": "histogram_quantile(0.99, sum(rate(qonvo_pipeline_duration_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p99"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Gate hits by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
