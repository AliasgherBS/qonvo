# Dashboard configuration. Copy to .env.local and fill in.
#
# Two kinds of variable live here and they behave differently:
#
#   NEXT_PUBLIC_*  baked into the client bundle at BUILD time. Changing one
#                  needs `npm run build` (host process) or a rebuilt image
#                  (compose) — a restart silently keeps the old value.
#   everything else read at server start, so a restart is enough.
#
# Parsed by run-dashboard.sh with `grep -v '^#' | xargs`, so comments must be on
# their own line: an inline `#` after a value becomes part of the value.

# Public origin of the API. Its own host, so CORS applies —
# QONVO_CORS_ORIGINS in the backend .env must list the dashboard's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public origin: feeds metadataBase, the sitemap, robots and OG tags.
# Wrong value here means wrong canonical URLs on every page.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Server-to-server base for the /backend/* rewrite. In compose this is the
# service name (http://api:8000); as a host process, localhost.
INTERNAL_API_URL=http://localhost:8000

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# AUTH_URL must be set explicitly. Host-derivation does NOT work behind a
# proxy: verified live that the tunnel forwarded Host and X-Forwarded-Host as
# the public domain, yet Auth.js still built
# "https://localhost:3002/api/auth/callback/google" — it honoured
# X-Forwarded-Proto but not the host, and Google rejected the sign-in with
# redirect_uri_mismatch from every device.
#
# AUTH_URL, QONVO_GOOGLE_OAUTH_REDIRECT_BASE, QONVO_DASHBOARD_BASE_URL and the
# Cloud console redirect URIs are coupled — change one, change all four.
AUTH_URL=http://localhost:3002

# Sign in with Google. Same Cloud OAuth client as the backend integrations
# flow, but the redirect URI lives on the DASHBOARD host:
#   https://<dashboard-host>/api/auth/callback/google
# Leave unset and only email+password login is offered.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
