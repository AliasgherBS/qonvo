# FastAPI backend base URL (browser + server both read this — public on purpose,
# the dashboard talks to the backend over plain REST, no secret in the URL itself).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth.js (next-auth v5) — generate with `npx auth secret`.
AUTH_SECRET=replace-with-a-generated-secret
NEXTAUTH_URL=http://localhost:3000
