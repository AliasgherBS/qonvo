# FastAPI backend base URL (browser + server both read this — public on purpose,
# the dashboard talks to the backend over plain REST, no secret in the URL itself).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth.js / next-auth v5 — generate the secret with `npx auth secret`.
AUTH_SECRET=replace-with-a-generated-secret
# v5 uses AUTH_URL (not NEXTAUTH_URL). Dev runs the dashboard on :3002.
AUTH_URL=http://localhost:3002
# Required behind a non-HTTPS/localhost host so Auth.js trusts the host header
# (also pass HOSTNAME=127.0.0.1 when launching standalone — see README).
AUTH_TRUST_HOST=true
