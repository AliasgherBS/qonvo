# --------------------------------------------------------------------------- #
# Staging dashboard (host node process on port 3012)
# --------------------------------------------------------------------------- #
# Copy to dashboard/.env.staging.local. Run it with ../run-dashboard-staging.sh,
# which builds into .next-staging so the two builds never overwrite each other.
#
# NEXT_PUBLIC_* values are baked in at BUILD time, so the staging build must be
# produced with this file present — a restart cannot change them.
#
# NOTE run-dashboard.sh parses env with `grep -v '^#' | xargs`, so a trailing
# inline `# comment` after a value breaks it. Keep comments on their own line.
# --------------------------------------------------------------------------- #

# Point at the STAGING api (port 8010), not production's 8000.
NEXT_PUBLIC_API_URL=http://localhost:8010
INTERNAL_API_URL=http://localhost:8010

# What paints the "Staging" badge in the topbar. Production leaves this unset.
NEXT_PUBLIC_QONVO_ENV=staging

# A different session secret from production, so a production cookie is not
# valid here and vice versa.
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3012

# Sign in with Google needs its redirect URI registered per exact URL, so it is
# off here until a staging hostname is added in the Google Cloud console.
# Use email + password on staging.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
