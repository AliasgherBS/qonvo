# Qonvo environment configuration.
# Copy to `.env` and fill in real values: `cp .env.example .env`
# The backend reads QONVO_-prefixed vars via pydantic-settings; the remaining
# vars configure the Postgres/MinIO/WAHA containers in docker-compose.yml.

# --------------------------------------------------------------------------- #
# General
# --------------------------------------------------------------------------- #
# Base domain; Caddy serves app.<DOMAIN> (dashboard) and api.<DOMAIN> (api).
DOMAIN=qonvo.example.com
QONVO_ENVIRONMENT=production
QONVO_DEBUG=false
QONVO_LOG_LEVEL=INFO
QONVO_DOMAIN=qonvo.example.com

# --------------------------------------------------------------------------- #
# Postgres (container + app DSN)
# --------------------------------------------------------------------------- #
POSTGRES_USER=qonvo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=qonvo
# Async SQLAlchemy DSN — host is the compose service name `postgres`.
# App role DSN — MUST be the non-superuser role (superusers bypass RLS!)
QONVO_DATABASE_URL=postgresql+asyncpg://qonvo_app:change-me-app-password@postgres:5432/qonvo
# Owner role DSN — used ONLY by alembic migrations
QONVO_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://qonvo:change-me-strong-password@postgres:5432/qonvo
# Password for the auto-created non-superuser app role
APP_DB_PASSWORD=change-me-app-password
# BYPASSRLS system role DSN — trusted cross-tenant paths only (webhook tenant
# resolution, scheduler). Never hand this DSN to request-scoped code.
QONVO_SYSTEM_DATABASE_URL=postgresql+asyncpg://qonvo_system:change-me-system-password@postgres:5432/qonvo
SYSTEM_DB_PASSWORD=change-me-system-password

# --------------------------------------------------------------------------- #
# Redis (queue, dedupe, debounce, locks, rate limiting)
# --------------------------------------------------------------------------- #
QONVO_REDIS_URL=redis://redis:6379/0

# --------------------------------------------------------------------------- #
# WAHA (WhatsApp HTTP API)
# --------------------------------------------------------------------------- #
# Shared API key: WAHA container auth AND backend outbound calls.
WAHA_API_KEY=change-me-waha-api-key
# Host port for WAHA dashboard/Swagger (localhost-only, dev convenience)
WAHA_HOST_PORT=3001
QONVO_WAHA_API_KEY=change-me-waha-api-key
# Backend → WAHA base URL (compose service name).
QONVO_WAHA_BASE_URL=http://waha:3000
# Fallback HMAC secret for verifying inbound webhooks (X-Webhook-Hmac).
# Per-session secrets are generated on session create and take precedence.
QONVO_WAHA_HMAC_SECRET=change-me-waha-hmac-secret
# NOWEB (websocket, no browser) — far more stable than WEBJS, which dropped
# inbound messages on a message-id parse crash. Needs WAHA >= 2026.7.2.
QONVO_WAHA_DEFAULT_ENGINE=NOWEB
# NOWEB store history backfill. The store itself is always enabled (sends 400
# without it); fullSync additionally pulls the linked number's ENTIRE WhatsApp
# history into WAHA's own store — measured at ~1.3 KB per historical message and
# ~4 KB per contact ever seen (one test number: 19,471 messages, 27 MB), none of
# which Qonvo reads: conversation context comes from Postgres. Leave off.
# QONVO_WAHA_FULL_SYNC=false
# URL WAHA posts webhooks to (reachable from the waha container).
QONVO_WEBHOOK_URL=http://api:8000/webhooks/waha
QONVO_WEBHOOK_RETRIES=3

# --------------------------------------------------------------------------- #
# Security
# --------------------------------------------------------------------------- #
# JWT secret shared with the dashboard (Auth.js mints, FastAPI verifies). >=32 bytes.
QONVO_JWT_SECRET=change-me-generate-with-secrets-token_urlsafe-48
QONVO_JWT_ALGORITHM=HS256
# Fernet master key for encrypting per-tenant integration credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store OUTSIDE the repo and back up separately (DESIGN.md §3, §12.2).
QONVO_FERNET_KEY=change-me-generate-a-real-fernet-key

# --------------------------------------------------------------------------- #
# MinIO (media object storage — required, DESIGN.md §12.3)
# --------------------------------------------------------------------------- #
MINIO_ROOT_USER=qonvo
MINIO_ROOT_PASSWORD=change-me-minio-password
QONVO_MINIO_ENDPOINT=minio:9000
QONVO_MINIO_ACCESS_KEY=qonvo
QONVO_MINIO_SECRET_KEY=change-me-minio-password
QONVO_MINIO_BUCKET=qonvo-media
QONVO_MINIO_SECURE=false

# --------------------------------------------------------------------------- #
# AI providers — REQUIRED for the bot to reply + index knowledge (DESIGN.md §4)
# --------------------------------------------------------------------------- #
# One OpenAI-compatible adapter covers OpenAI / OpenRouter / Groq / Gemini (via its
# OpenAI-compat endpoint) / any custom base_url. Provider name maps to a preset
# base URL; set base_url only for a custom endpoint. Per-tenant overrides live in
# the dashboard; these are the system defaults.
QONVO_LLM_PROVIDER=gemini
QONVO_LLM_MODEL=gemini-2.0-flash
# QONVO_LLM_BASE_URL=            # only for a custom/self-hosted endpoint
QONVO_LLM_API_KEY=change-me-llm-api-key
# Embeddings for RAG (pgvector column is 1536 dims — the adapter pins that).
# A single Gemini key covers both LLM + embeddings. Groq has NO embeddings endpoint.
QONVO_EMBEDDING_PROVIDER=gemini
QONVO_EMBEDDING_MODEL=gemini-embedding-001
# QONVO_EMBEDDING_BASE_URL=
QONVO_EMBEDDING_API_KEY=change-me-embedding-api-key

# --------------------------------------------------------------------------- #
# Integrations — Google Calendar / Sheets (Phase 3, DESIGN.md §7)
# --------------------------------------------------------------------------- #
# One platform-wide OAuth client serves every tenant; each tenant's refresh token
# is Fernet-encrypted per-row in `integrations`. Create a "Web application" client
# in the Google Cloud console and register BOTH redirect URIs:
#   <REDIRECT_BASE>/api/integrations/oauth/callback   (Calendar / Sheets)
#   <REDIRECT_BASE>/api/auth/callback/google          (Sign in with Google)
# Enable the Calendar, Sheets, and Drive APIs on the project.
# Set publishing status to "In production": clients left in Testing get refresh
# tokens that expire after 7 days, which silently kills every tenant weekly.
# The scopes used are all non-sensitive, so this needs no Google review.
QONVO_GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
QONVO_GOOGLE_OAUTH_CLIENT_SECRET=change-me-google-client-secret
# Public origin Google redirects back to — must match the console entry exactly.
# If you front everything with one tunnel/domain pointing at the dashboard, the
# API lives under /backend (next.config.ts rewrite), so include that suffix:
#   QONVO_GOOGLE_OAUTH_REDIRECT_BASE=https://your-host/backend
QONVO_GOOGLE_OAUTH_REDIRECT_BASE=http://localhost:8000
# Where the OAuth callback sends the browser once the grant is stored.
QONVO_DASHBOARD_BASE_URL=http://localhost:3002
# Google Picker (the "choose a spreadsheet" dialog): a Picker-restricted API key
# and the Cloud project number. Without these, owners can still use
# "Make one for me" to have Qonvo create a sheet.
# QONVO_GOOGLE_PICKER_API_KEY=
# QONVO_GOOGLE_PICKER_APP_ID=
# QONVO_GOOGLE_DEFAULT_TIMEZONE=UTC
# QONVO_BOOKING_DEFAULT_DURATION_MINUTES=30

# --------------------------------------------------------------------------- #
# Email — owner alerts (Phase 3, DESIGN.md §12.1)
# --------------------------------------------------------------------------- #
# Transport: "log" (dev default — just logs, never sends), "resend", or "smtp".
# Sends welcome / password-reset / team-invite / owner-handoff emails.
# QONVO_EMAIL_PROVIDER=log
# QONVO_EMAIL_FROM=Qonvo <alerts@yourdomain.com>
# Where replies go. QONVO_EMAIL_FROM is a no-reply sender on a sending subdomain
# with no mailbox behind it, so without this a reply is silently discarded.
# QONVO_EMAIL_REPLY_TO=support@yourdomain.com
# QONVO_EMAIL_RESEND_API_KEY=re_...
#
# Gmail SMTP (needs 2FA + an App Password, not your login password):
#   Use port 465 (implicit SSL) — many hosts (VPS/WSL) intercept STARTTLS on 587
#   so the handshake times out. Port 465 → the code uses SMTP_SSL automatically.
# QONVO_EMAIL_SMTP_HOST=smtp.gmail.com
# QONVO_EMAIL_SMTP_PORT=465
# QONVO_EMAIL_SMTP_USER=you@gmail.com
# QONVO_EMAIL_SMTP_PASSWORD=your-16-char-app-password
# QONVO_EMAIL_SMTP_STARTTLS=true   # ignored on 465 (implicit SSL); used on 587
# QONVO_EMAIL_FROM must be your Gmail address (Gmail only sends from the authed account).
#
# NOTE: docker reads env_file at container CREATE — after editing email vars run
#   `docker compose up -d --force-recreate api worker scheduler` (a bare restart won't reload).

# --------------------------------------------------------------------------- #
# Billing (docs/superpowers/specs/2026-09-04-billing-design.md)
# --------------------------------------------------------------------------- #
# Qonvo sells through a merchant of record, so this side only reconciles what
# the provider reports. No prices, cards or invoices live in this codebase.
# "manual" (default) = no gateway: owners are told to contact you, and you
# record the plan with PUT /api/admin/tenants/{id}/subscription.
# QONVO_BILLING_PROVIDER=manual
# Signing secret for POST /webhooks/billing/{provider}, once a gateway exists.
# QONVO_BILLING_WEBHOOK_SECRET=
# Provider price id -> plan key, so a new price can be sold without a deploy.
# QONVO_BILLING_PRICE_MAP={"pri_123":"growth"}
# Days a failed payment keeps answering while the provider retries the card.
# A card failing on Tuesday must not silence a business on Tuesday.
# QONVO_BILLING_GRACE_DAYS=7
#
# --- Polar (set QONVO_BILLING_PROVIDER=polar to use it) ---
# Sandbox and production are separate worlds. A production token against the
# sandbox API fails with a 401 that reads like a bad token, so this is worth
# getting right before debugging anything else.
# QONVO_POLAR_SERVER=sandbox
# Organization access token (polar_oat_...). NEVER commit this.
# QONVO_POLAR_ACCESS_TOKEN=
# Webhook signing secret from the Polar dashboard. Both of Polar's schemes are
# accepted (it changed on 2026-09-08), so paste it exactly as shown and do not
# base64 it yourself.
# QONVO_POLAR_WEBHOOK_SECRET=
# Polar product/price id -> plan key. Read from the Polar dashboard after you
# create the three products. Without this a paid upgrade resolves to no plan
# and the tenant keeps their old entitlements.
# QONVO_BILLING_PRICE_MAP={"<polar_product_id>":"starter","...":"growth","...":"scale"}

# Observability: expose GET /metrics (Prometheus). Default on.
# QONVO_METRICS_ENABLED=true

# --------------------------------------------------------------------------- #
# Voice — STT/TTS (Phase 2, DESIGN.md §2, §4)
# --------------------------------------------------------------------------- #
# Gemini's OpenAI-compat endpoint has NO audio endpoints, so voice needs an
# OpenAI/Groq-style key even if the LLM is Gemini. Unset api_key = voice off.
# Groq is a good fit for STT (fast, cheap Whisper).
# QONVO_STT_PROVIDER=groq
# QONVO_STT_MODEL=whisper-large-v3
# QONVO_STT_API_KEY=gsk_...
# QONVO_TTS_PROVIDER=openai
# QONVO_TTS_MODEL=tts-1
# QONVO_TTS_VOICE=alloy
# QONVO_TTS_API_KEY=sk-...
# QONVO_VOICE_REPLY_MODE=match   # match | always | never

# --------------------------------------------------------------------------- #
# Booking reminders (Phase 3, §5.7) — capped outbound
# --------------------------------------------------------------------------- #
# QONVO_REMINDERS_ENABLED=true
# QONVO_REMINDER_LOOKAHEAD_HOURS=24

# --------------------------------------------------------------------------- #
# Pipeline tuning (optional — sensible defaults in app/core/config.py)
# --------------------------------------------------------------------------- #
# QONVO_DEBOUNCE_WINDOW_SECONDS=5.0
# QONVO_STALENESS_THRESHOLD_SECONDS=7200
# QONVO_SEND_MIN_DELAY_SECONDS=3.0
# QONVO_SEND_MAX_DELAY_SECONDS=8.0
# QONVO_SEND_DEFAULT_DAILY_CAP=500

# --------------------------------------------------------------------------- #
# Backups (scripts/backup.sh)
# --------------------------------------------------------------------------- #
# BACKUP_TARGET_DIR=/var/backups/qonvo
# BACKUP_RETENTION_DAYS=14
# BACKUP_MINIO_TARGET=              # e.g. s3/backup-bucket (an mc alias/path)
